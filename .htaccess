RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# API Routes - route to backend/api/
RewriteRule ^api/auth/register$ backend/api/auth.php?action=register [L,QSA]
RewriteRule ^api/auth/login$ backend/api/auth.php?action=login [L,QSA]
RewriteRule ^api/auth/user$ backend/api/auth.php [L,QSA]
RewriteRule ^api/members(.*)$ backend/api/members.php$1 [L,QSA]
RewriteRule ^api/products(.*)$ backend/api/products.php$1 [L,QSA]
RewriteRule ^api/orders(.*)$ backend/api/orders.php$1 [L,QSA]
RewriteRule ^api/localities$ backend/api/localities.php [L,QSA]
RewriteRule ^api/membership-levels$ backend/api/membership-levels.php [L,QSA]
RewriteRule ^api/partner-shops$ backend/api/partner-shops.php [L,QSA]
RewriteRule ^api/product-requests(.*)$ backend/api/product-requests.php$1 [L,QSA]
RewriteRule ^api/admin(.*)$ backend/api/admin.php$1 [L,QSA]
RewriteRule ^api/countries$ backend/api/countries.php [L,QSA]
RewriteRule ^api/site-settings(.*)$ backend/api/site-settings.php$1 [L,QSA]

# Webhooks
RewriteRule ^api/webhooks/paypal$ backend/api/webhooks/paypal.php [L,QSA]
RewriteRule ^api/webhooks/paystack$ backend/api/webhooks/paystack.php [L,QSA]

# Payment checkout
RewriteRule ^api/checkout/paypal$ backend/api/checkout/paypal.php [L,QSA]
RewriteRule ^api/checkout/paystack$ backend/api/checkout/paystack.php [L,QSA]

# File upload
RewriteRule ^api/upload$ backend/api/upload.php [L,QSA]

# Frontend - serve React build from dist/
# Don't rewrite if file exists (for assets, images, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/backend/
RewriteCond %{REQUEST_URI} !^/uploads/
RewriteRule ^(.*)$ dist/index.html [L]

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # CORS headers for API
    SetEnvIf Origin "^(.+)$" ORIGIN_DOMAIN=$1
    Header set Access-Control-Allow-Origin "%{ORIGIN_DOMAIN}e" env=ORIGIN_DOMAIN
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization"
    Header set Access-Control-Allow-Credentials "true"
</IfModule>

# Correct MIME types
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType application/javascript .mjs
    AddType text/css .css
    AddType application/json .json
</IfModule>

# PHP settings
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 60
    php_value max_input_time 60
    php_value memory_limit 256M
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# Prevent directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "\.(env|sql|log|ini)$">
    Order allow,deny
    Deny from all
</FilesMatch>
